{
  "name": "dar-al-salam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "gen:placeholder": "node --import tsx tools/placeholder/index.ts",
    "build:assets": "node --import tsx tools/build/index.ts",
    "prepare:world": "node --import tsx tools/prepare.ts",
    "dev": "pnpm prepare:world && vite --host 0.0.0.0",
    "build": "pnpm build:assets --prod && vite build",
    "build:preview": "pnpm prepare:world && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "build:vercel": "node --import tsx tools/vercel-build.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "maxrects-packer": "2.7.3",
    "pixi-filters": "^6.1.3",
    "pixi.js": "^8.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.1",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.21",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.4",
    "vitest": "^3.1.2",
    "@playwright/test": "^1.51.1"
  }
}
